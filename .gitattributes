# Consistent source text, with Windows line endings for launch scripts.
* text=auto
*.py text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.bat text eol=crlf
*.png binary
*.jpg binary

# Keep development files in Git, but omit them from GitHub Download ZIP.
/tests export-ignore
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/docs export-ignore

# Icon source material and sizes not used by the application.
/assets/lan-speaker-icon.png export-ignore
/assets/lan-speaker-icon.prompt.txt export-ignore
/assets/lan-speaker-icons.zip export-ignore
/assets/icons/lan-speaker-24.png export-ignore
/assets/icons/lan-speaker-96.png export-ignore
/assets/icons/lan-speaker-256.png export-ignore
/assets/icons/lan-speaker-1024.png export-ignore
